{
  "name": "@vault/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas de validação compartilhados entre Web, Android e API.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.esm.json && node ../../scripts/finalize-esm-build.mjs dist/esm",
    "clean": "node ../../scripts/clean-dist.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@vault/eslint-config": "workspace:*",
    "@vault/tsconfig": "workspace:*",
    "eslint": "^9.38.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
