{
  "name": "crypta",
  "version": "0.1.0",
  "private": true,
  "description": "Cofre de senhas multiusuário, self-hosted, com criptografia no cliente.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm -r --filter \"./apps/**\" run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "clean": "pnpm -r run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm build:packages && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
