// Schema Prisma do cofre de senhas.
//
// ESTADO ATUAL (R0.3): identidade e cofres.
//
// Convenções fixadas e não negociáveis sem ADR:
//
//   - identificador público é UUIDv7 em CHAR(36) (ADR 0019), gerado pelo Prisma,
//     exceto nas entidades que o cliente cifra, onde quem gera é o cliente e a
//     coluna não tem `@default` (ADR 0025);
//   - exclusão é física, sem `deleted_at` e sem filtro de exclusão em consulta,
//     e o comportamento de cada FK está declarado no ADR 0020;
//   - tabelas no plural em snake_case, colunas em snake_case (DATABASE.md secao 5);
//   - `created_at` e `updated_at` em UTC nas tabelas relevantes.
//
// Regra permanente: nenhuma coluna em texto aberto para nome de cofre,
// descrição, nome de site, link, usuário da credencial, senha, observação,
// VaultKey ou chave privada (CLAUDE.md secao 44).
//
// A fonte de verdade da modelagem é docs/DATABASE.md. Toda alteração aqui
// atualiza aquele documento no mesmo pull request (CLAUDE.md secao 43).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Conta de usuário.
///
/// Guarda apenas o que autentica e identifica. O material que descriptografa
/// está em `UserKeyBundle`, e mesmo lá a metade privada é opaca ao servidor.
model User {
  id String @id @default(uuid(7)) @db.Char(36)

  /// Nome de perfil. Texto aberto por decisão: não é conteúdo de cofre
  /// (DATABASE.md secao 4).
  name String @db.VarChar(120)

  /// Identificador de login, normalizado em minúsculas antes de gravar.
  email String @unique @db.VarChar(254)

  /// `HMAC-SHA-256(pepper, authSecret)` em hexadecimal (ADR 0022).
  ///
  /// Não é o `AuthSecret`, e não serve como credencial: o pepper vive fora do
  /// banco, derivado de `AUTH_SERVER_SECRET`.
  authSecretHash String @map("auth_secret_hash") @db.Char(64)

  /// Versão do `AUTH_SERVER_SECRET` que gerou o hash acima.
  ///
  /// Existe para que rotacionar o segredo não exija que ninguém troque de
  /// senha: o login recalcula e regrava quando esta versão não é a corrente.
  authSecretVersion Int @default(1) @map("auth_secret_version") @db.UnsignedSmallInt

  /// Conta desativada não autentica. O motivo só é revelado a quem já
  /// apresentou o `AuthSecret` correto (ADR 0022).
  isActive Boolean @default(true) @map("is_active")

  /// Falhas consecutivas de login. Zera no sucesso.
  ///
  /// Fica no banco, e não em memória, porque um controle de segurança que some
  /// no restart do container não é controle (ADR 0022).
  failedLoginAttempts Int @default(0) @map("failed_login_attempts") @db.UnsignedSmallInt

  /// Instante até o qual o login é recusado. Nunca é permanente.
  lockedUntil DateTime? @map("locked_until") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  keyBundle    UserKeyBundle?
  sessions     Session[]
  memberships  VaultMember[]
  keyEnvelopes VaultKeyEnvelope[]

  @@map("users")
}

/// Material criptográfico do usuário, 1:1 com a conta.
///
/// Os parâmetros KDF ficam aqui, e não em configuração global, porque o cliente
/// precisa deles ANTES de autenticar e porque recalibrar o Argon2id (ADR 0018)
/// não pode invalidar conta existente.
model UserKeyBundle {
  id String @id @default(uuid(7)) @db.Char(36)

  userId String @unique @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kdfAlgorithm String @map("kdf_algorithm") @db.VarChar(32)
  kdfVersion   Int    @map("kdf_version") @db.UnsignedSmallInt

  /// Salt do Argon2id em base64url. 16 bytes viram 22 caracteres.
  kdfSalt String @map("kdf_salt") @db.VarChar(32)

  /// Custo de memória em KiB. `UnsignedInt` porque 64 MiB já são 65536.
  kdfMemory      Int @map("kdf_memory") @db.UnsignedInt
  kdfIterations  Int @map("kdf_iterations") @db.UnsignedSmallInt
  kdfParallelism Int @map("kdf_parallelism") @db.UnsignedSmallInt

  /// Chave pública X25519 em base64url. 32 bytes viram 43 caracteres.
  ///
  /// Texto aberto por necessidade: é ela que os outros membros usam para
  /// endereçar envelopes. A AAD do bundle a amarra ao ciphertext da privada,
  /// então trocá-la aqui é detectado no desbloqueio (ADR 0023).
  publicKey String @map("public_key") @db.VarChar(43)

  /// Chave privada X25519 cifrada com a `UserEncryptionKey`, em base64url.
  ///
  /// O servidor não tem como abrir: a chave deriva da senha e nunca sai do
  /// cliente (ADR 0003, ADR 0004).
  encryptedPrivateKey String @map("encrypted_private_key") @db.VarChar(255)

  /// Nonce da XChaCha20-Poly1305 em base64url. 24 bytes viram 32 caracteres.
  privateKeyNonce String @map("private_key_nonce") @db.VarChar(32)

  cryptoVersion Int @map("crypto_version") @db.UnsignedSmallInt
  schemaVersion Int @map("schema_version") @db.UnsignedSmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("user_key_bundles")
}

/// Sessão autenticada.
///
/// O `id` é o `sid` que o access token carrega. A autorização o consulta a cada
/// requisição, e é isso que torna a revogação imediata em vez de esperar os 15
/// minutos do token (ADR 0021, SECURITY.md secao 29).
///
/// Revogar é APAGAR a linha (ADR 0020). Não existe coluna de revogação.
///
/// Nenhum prazo é gravado: inatividade e teto absoluto são calculados a partir
/// de `last_used_at` e `created_at` com os valores de ambiente vigentes. Gravar
/// congelaria a configuração no momento do login, e apertar um prazo deixaria de
/// valer para as sessões já abertas — o oposto do que o ADR 0021 descreve.
model Session {
  id String @id @default(uuid(7)) @db.Char(36)

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Agrupa as rotações de uma mesma sessão. Reuso detectado derruba a família.
  familyId String @map("family_id") @db.Char(36)

  /// `SHA-256` do refresh token corrente, em hexadecimal.
  ///
  /// Sem pepper, ao contrário do `AuthSecret`: são 256 bits sem estrutura, e não
  /// existe preimagem adivinhável a proteger (ADR 0022). A busca é por este
  /// índice, nunca por varredura.
  refreshTokenHash String @unique @map("refresh_token_hash") @db.Char(64)

  /// `SHA-256` do token imediatamente anterior, para a janela de tolerância de
  /// 10 segundos do ADR 0021. Fora da janela, apresentá-lo é reuso.
  previousTokenHash String? @map("previous_token_hash") @db.Char(64)

  /// Quando a rotação que produziu `previous_token_hash` aconteceu.
  rotatedAt DateTime? @map("rotated_at") @db.DateTime(3)

  /// `web`, `android` ou `extension`.
  clientType String  @map("client_type") @db.VarChar(16)
  clientName String? @map("client_name") @db.VarChar(120)

  /// Metadados de sessão exibidos na tela de sessões. IPv6 cabe em 45 caracteres.
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  /// Âncora do teto absoluto. Nenhuma rotação a move.
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  /// Âncora do limite de inatividade. Cada rotação a renova.
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.DateTime(3)

  @@index([userId])
  @@index([familyId])
  @@index([previousTokenHash])
  @@map("sessions")
}

/// Resultado de uma operação idempotente (API.md secao 38, CLAUDE.md secao 38).
///
/// Não guarda corpo de resposta. O `POST /setup` responde com um access token, e
/// gravá-lo transformaria esta tabela em depósito de credencial viva — um dump
/// devolveria sessões utilizáveis. O replay reconstrói a resposta a partir de
/// `resource_id` e emite um access token novo.
///
/// Sem chave estrangeira, pelo mesmo motivo do `AuditLog` no ADR 0020: o
/// registro precisa sobreviver à exclusão da entidade que ele descreve.
model IdempotencyRecord {
  id String @id @default(uuid(7)) @db.Char(36)

  /// Operação a que a chave pertence. Duas rotas diferentes podem receber a
  /// mesma chave de clientes diferentes sem colidir.
  scope String @map("scope") @db.VarChar(64)

  /// Valor do header `Idempotency-Key`.
  idempotencyKey String @map("idempotency_key") @db.VarChar(255)

  /// `SHA-256` do payload canônico. Mesma chave com payload diferente é
  /// `409 IDEMPOTENCY_CONFLICT`, não um replay silencioso.
  requestHash String @map("request_hash") @db.Char(64)

  /// Identificador do recurso criado, quando houve um.
  resourceId String? @map("resource_id") @db.Char(36)

  responseStatus Int @map("response_status") @db.UnsignedSmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey])
  @@map("idempotency_records")
}

/// Papel de um membro dentro de um cofre (PROJECT_SCOPE.md, papéis da V1).
///
/// `READER` e transferência de propriedade estão fora do escopo da V1
/// (CLAUDE.md secao 11). Acrescentar valor aqui é mudança de escopo.
enum VaultRole {
  OWNER
  EDITOR
}

/// Cofre.
///
/// O servidor não sabe como o cofre se chama. Nome e descrição vivem cifrados
/// com a `VaultKey`, que ele nunca recebe (ADR 0003, ADR 0005).
///
/// O `id` NÃO tem `@default`, e a ausência é a decisão do ADR 0025: quem gera é
/// o cliente, porque a AAD da metadata amarra a este valor e o conteúdo é
/// cifrado antes do `POST`. Com um default aqui, um `INSERT` sem id gravaria uma
/// linha cujo conteúdo ninguém consegue abrir.
model Vault {
  id String @id @db.Char(36)

  /// Nonce da XChaCha20-Poly1305 em base64url. 24 bytes viram 32 caracteres.
  metadataNonce String @map("metadata_nonce") @db.VarChar(32)

  /// Nome e descrição cifrados, em base64url.
  ///
  /// `Text` e não `VarChar`: o limite do formato — 200 caracteres de nome e
  /// 2000 de descrição — chega a cerca de 12 mil caracteres depois de UTF-8,
  /// tag e base64url, e uma `VarChar` desse tamanho competiria com o limite de
  /// linha do InnoDB.
  metadataCiphertext String @map("metadata_ciphertext") @db.Text

  /// Algoritmo declarado do payload, para que a resposta o devolva sem inferir.
  metadataAlgorithm String @map("metadata_algorithm") @db.VarChar(32)

  cryptoVersion Int @map("crypto_version") @db.UnsignedSmallInt
  schemaVersion Int @map("schema_version") @db.UnsignedSmallInt

  /// Concorrência otimista (DATABASE.md secao 5, API.md secao 13). Toda mutação
  /// bem-sucedida incrementa exatamente uma vez.
  version Int @default(1) @db.UnsignedInt

  /// Geração da `VaultKey`. Incrementa a cada rekey (R0.5).
  keyVersion Int @default(1) @map("key_version") @db.UnsignedInt

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  members   VaultMember[]
  envelopes VaultKeyEnvelope[]

  @@map("vaults")
}

/// Associação entre usuário e cofre.
///
/// `User` → `VaultMember` é `Restrict` (ADR 0020): excluir quem ainda é `OWNER`
/// deixaria o cofre sem dono e os demais membros sem quem faça rekey. A
/// exclusão precisa falhar e obrigar a apagar o cofre antes.
///
/// **`OWNER` único por cofre é garantido pelo banco, não pela aplicação.**
///
/// MySQL não tem índice único parcial, e a coluna gerada que o substituiria não
/// é permitida aqui: uma FK com `ON DELETE CASCADE` não pode incidir sobre a
/// coluna base de uma coluna `STORED`, e `vault_id` é as duas coisas ao mesmo
/// tempo. A tentativa falha com o erro 1215 do MySQL, não com um aviso.
///
/// O que sustenta a garantia é `ownerVaultId`: vale `vaultId` na linha do
/// `OWNER` e é nulo nas demais. O índice único recusa o segundo `OWNER` do
/// mesmo cofre e ignora os nulos; um `CHECK` na migration recusa qualquer
/// combinação em que a coluna discorde de `role` e `vaultId`. Escrever o valor
/// é responsabilidade do repositório — mentir nele é que não é possível.
model VaultMember {
  id String @id @default(uuid(7)) @db.Char(36)

  vaultId String @map("vault_id") @db.Char(36)
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  role VaultRole

  /// Espelho de `vaultId`, apenas na linha do `OWNER`. Ver a nota acima: é o
  /// que torna "um dono por cofre" uma restrição de banco.
  ownerVaultId String? @unique @map("owner_vault_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([vaultId, userId])
  @@index([userId])
  @@map("vault_members")
}

/// `VaultKey` cifrada para a chave pública de um membro (ADR 0005, ADR 0023).
///
/// O servidor guarda o envelope e não tem como abri-lo: ele é selado para uma
/// chave pública cuja metade privada nunca sai do cliente.
///
/// Não existe coluna `nonce`, e a ausência é decisão: o nonce é derivado junto
/// com a chave da AEAD e não trafega. Transmiti-lo criaria uma segunda fonte de
/// verdade capaz de discordar da primeira.
model VaultKeyEnvelope {
  id String @id @default(uuid(7)) @db.Char(36)

  vaultId String @map("vault_id") @db.Char(36)
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  /// `Restrict` porque a relação não está na tabela do ADR 0020, e o padrão
  /// conservador do `CLAUDE.md` secao 45 é não propagar exclusão sem decisão.
  /// Na prática a exclusão de conta já é bloqueada antes, por `VaultMember`.
  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Geração da `VaultKey` que este envelope entrega.
  keyVersion Int @map("key_version") @db.UnsignedInt

  cryptoVersion Int @map("crypto_version") @db.UnsignedSmallInt

  algorithm String @db.VarChar(64)

  /// Chave pública X25519 efêmera em base64url. 32 bytes viram 43 caracteres.
  ephemeralPublicKey String @map("ephemeral_public_key") @db.VarChar(43)

  /// `VaultKey` cifrada com a tag, em base64url. 48 bytes viram 64 caracteres.
  encryptedVaultKey String @map("encrypted_vault_key") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  /// Um envelope por membro por geração de chave. O rekey da R0.5 grava a
  /// geração seguinte e apaga a anterior.
  @@unique([vaultId, userId, keyVersion])
  @@index([userId])
  @@map("vault_key_envelopes")
}

/// Trilha de auditoria.
///
/// **Sem chave estrangeira**, de propósito (ADR 0020): o registro precisa
/// sobreviver à exclusão da entidade que descreve. Como a exclusão é física, é
/// esta tabela que guarda a prova de que algo existiu e foi apagado.
///
/// Nada de conteúdo aqui. Nome de cofre, senha, observação e ciphertext estão
/// proibidos (ARCHITECTURE.md secao 33.3); só entram identificadores, ação e
/// metadados técnicos.
model AuditLog {
  id String @id @default(uuid(7)) @db.Char(36)

  /// Quem executou. Guardado como valor, não como FK.
  actorId String? @map("actor_id") @db.Char(36)

  /// Verbo estável, em UPPER_SNAKE_CASE. Ex.: `VAULT_CREATED`.
  action String @db.VarChar(64)

  entityType String  @map("entity_type") @db.VarChar(32)
  entityId   String? @map("entity_id") @db.Char(36)
  vaultId    String? @map("vault_id") @db.Char(36)

  /// Correlaciona com o log estruturado da requisição.
  requestId String? @map("request_id") @db.VarChar(64)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)

  /// `SUCCESS` ou `FAILURE`.
  result String @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([actorId])
  @@index([vaultId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
