    "@crypta/validation": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
