{
  "name": "@crypta/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicação Web do cofre de senhas.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "clean": "node ../../scripts/clean-dist.mjs",
