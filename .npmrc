# Falha o install quando o lockfile estiver desatualizado em CI.
strict-peer-dependencies=false

# Mantém as dependências dos workspaces isoladas, evitando imports acidentais
# de pacotes não declarados (phantom dependencies).
hoist=false
shamefully-hoist=false

# Garante que a versão de pnpm usada seja a declarada em packageManager.
engine-strict=true
