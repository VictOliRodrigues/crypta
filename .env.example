# =============================================================================
# Crypta — Exemplo de variáveis de ambiente
#
# Copie para .env e preencha com valores LOCAIS. Nunca commite o .env real.
# Nunca coloque aqui token do Coolify, token do GHCR, secret de GitHub
# Environment ou chave de assinatura (STYLE_GUIDE.md secao 69).
#
# Ambientes oficiais: development | staging | production
# Cada ambiente possui banco, secrets, URLs e domínios próprios.
# =============================================================================


# -----------------------------------------------------------------------------
# apps/api — Backend NestJS
# -----------------------------------------------------------------------------

# Ambiente de execução do runtime Node. Um dos: development | production | test
NODE_ENV=development

# Ambiente lógico do produto. Um dos: development | staging | production
# Validado no startup. Não use apelidos como dev/hml/prod.
APP_ENVIRONMENT=development

# Metadados de build. Injetados pelo CI via build args do Dockerfile.
# Localmente podem ficar com os valores de fallback abaixo.
APP_VERSION=0.0.0-local
APP_COMMIT=local
APP_BUILT_AT=1970-01-01T00:00:00.000Z

# Porta HTTP da API.
API_PORT=3000

# Conexão MySQL. Em development aponta para o container local;
# em staging/production aponta para a rede privada do Coolify.
# O banco NÃO deve ter porta pública.
DATABASE_URL="mysql://crypta:CHANGE_ME@localhost:3306/crypta_development"

# Origens permitidas no CORS, separadas por vírgula. Sem curinga.
# Cada ambiente lista apenas os seus próprios domínios.
CORS_ORIGINS=http://localhost:5173

# Nível de log estruturado. Um dos: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Conexão do banco de TESTES, usada apenas por `pnpm --filter @crypta/api test:e2e`.
# Separada de DATABASE_URL de propósito: a suíte apaga tabelas, e o harness
# recusa rodar se o nome do banco não terminar em `_test`.
#
# Suba um MySQL descartável para isso:
#
#   docker run -d --name crypta-mysql-test \
#     -e MYSQL_ROOT_PASSWORD=crypta_local_test -e MYSQL_DATABASE=crypta_test \
#     -p 3308:3306 mysql:8.0 \
#     --character-set-server=utf8mb4 --collation-server=utf8mb4_0900_ai_ci \
#     --default-time-zone=+00:00
#
# A porta 3308 evita conflito com um MySQL local na 3306.
TEST_DATABASE_URL="mysql://root:crypta_local_test@127.0.0.1:3308/crypta_test"


# -----------------------------------------------------------------------------
# apps/web — Frontend React + Vite
#
# Tudo que começa com VITE_ é embutido no bundle e fica PÚBLICO.
# Nunca coloque segredo em variável VITE_.
# -----------------------------------------------------------------------------

# URL base da API, incluindo o prefixo de versão.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Metadados exibidos na área de diagnóstico da Web.
VITE_APP_ENVIRONMENT=development
VITE_APP_VERSION=0.0.0-local
VITE_APP_COMMIT=local


# -----------------------------------------------------------------------------
# Reservado para a R0.2 — Identidade e criptografia
#
# Estas variáveis ainda NÃO são lidas pela aplicação. Serão introduzidas junto
# com o módulo de autenticação, com validação de startup e ADR correspondente.
# Mantidas aqui apenas como referência do que precisará ser provisionado.
# -----------------------------------------------------------------------------

# Valores e faixas fixados pelos ADRs 0021 e 0022. Fora da faixa, a API não sobe.
# Não existe REFRESH_COOKIE_DOMAIN: o cookie é host-only, para que a sessão
# não seja compartilhada entre development, staging e production.

# Par Ed25519 do access token, em BASE64 DO PEM, numa linha só (ADR 0022).
# O PEM cru é multilinha e uma quebra de linha invisível em variable já custou
# um deploy nesta infraestrutura (config_user.md secao 41.1).
# O par é POR AMBIENTE. Na partida a API assina e verifica um valor de prova:
# chave trocada entre ambientes falha ali, não na primeira requisição real.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Segredo do servidor, 32 bytes em base64url, no formato v<N>:<valor> (ADR 0022).
# Deriva o pepper do verificador do AuthSecret e o segredo dos parâmetros KDF
# sintéticos, por HKDF com infos distintas.
#
# ATENÇÃO: perder este valor sem ter rotacionado torna TODA CONTA INACESSÍVEL de
# forma definitiva — a V1 não tem recuperação (SECURITY.md secao 28). Faça backup
# junto das chaves JWT, fora do backup do banco.
# AUTH_SERVER_SECRET=v1:

# Versão anterior do segredo, durante uma rotação. Opcional.
# Só pode ser removida quando nenhum usuário ainda referenciar essa versão.
# AUTH_SERVER_SECRET_PREVIOUS=

# 15m — faixa aceita: 1m a 60m.
# ACCESS_TOKEN_TTL=15m

# Inatividade da sessão, renovada a cada rotação. 7d — faixa aceita: 1h a 90d.
# REFRESH_TOKEN_TTL=7d

# Teto absoluto contado da criação da sessão; nenhuma rotação o estende.
# 30d — faixa aceita: 1d a 365d, nunca menor que REFRESH_TOKEN_TTL.
# REFRESH_TOKEN_ABSOLUTE_TTL=30d

# Strict, Lax ou None. Strict serve quando Web e API ficam sob o mesmo domínio
# registrável, que é o caso do deployment de referência. Só use None se elas
# ficarem em domínios registráveis distintos: nesse caso a validação de Origin
# passa a ser a única barreira de CSRF do endpoint de refresh.
# REFRESH_COOKIE_SAMESITE=Strict

# Bloqueio progressivo de login, por conta, no banco (ADR 0022).
# Nunca há bloqueio permanente: a espera dobra até o teto e zera no sucesso.
# LOGIN_MAX_ATTEMPTS=5              faixa aceita: 3 a 20
# LOGIN_LOCK_INITIAL_SECONDS=60     faixa aceita: 10 a 600
# LOGIN_LOCK_MAX_SECONDS=900        faixa aceita: 60 a 86400, nunca menor que o inicial

# Filtro por IP nas rotas de autenticação, em memória do processo.
# Com mais de uma réplica o teto efetivo é este valor vezes o número de réplicas.
# AUTH_IP_RATE_LIMIT=60             faixa aceita: 10 a 600
