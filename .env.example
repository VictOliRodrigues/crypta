# =============================================================================
# Cofre de Senhas — Exemplo de variáveis de ambiente
#
# Copie para .env e preencha com valores LOCAIS. Nunca commite o .env real.
# Nunca coloque aqui token do Coolify, token do GHCR, secret de GitHub
# Environment ou chave de assinatura (STYLE_GUIDE.md secao 69).
#
# Ambientes oficiais: development | staging | production
# Cada ambiente possui banco, secrets, URLs e domínios próprios.
# =============================================================================


# -----------------------------------------------------------------------------
# apps/api — Backend NestJS
# -----------------------------------------------------------------------------

# Ambiente de execução do runtime Node. Um dos: development | production | test
NODE_ENV=development

# Ambiente lógico do produto. Um dos: development | staging | production
# Validado no startup. Não use apelidos como dev/hml/prod.
APP_ENVIRONMENT=development

# Metadados de build. Injetados pelo CI via build args do Dockerfile.
# Localmente podem ficar com os valores de fallback abaixo.
APP_VERSION=0.0.0-local
APP_COMMIT=local
APP_BUILT_AT=1970-01-01T00:00:00.000Z

# Porta HTTP da API.
API_PORT=3000

# Conexão MySQL. Em development aponta para o container local;
# em staging/production aponta para a rede privada do Coolify.
# O banco NÃO deve ter porta pública.
DATABASE_URL="mysql://vault:CHANGE_ME@localhost:3306/password_vault_development"

# Origens permitidas no CORS, separadas por vírgula. Sem curinga.
# Cada ambiente lista apenas os seus próprios domínios.
CORS_ORIGINS=http://localhost:5173

# Nível de log estruturado. Um dos: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# apps/web — Frontend React + Vite
#
# Tudo que começa com VITE_ é embutido no bundle e fica PÚBLICO.
# Nunca coloque segredo em variável VITE_.
# -----------------------------------------------------------------------------

# URL base da API, incluindo o prefixo de versão.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Metadados exibidos na área de diagnóstico da Web.
VITE_APP_ENVIRONMENT=development
VITE_APP_VERSION=0.0.0-local
VITE_APP_COMMIT=local


# -----------------------------------------------------------------------------
# Reservado para a R0.2 — Identidade e criptografia
#
# Estas variáveis ainda NÃO são lidas pela aplicação. Serão introduzidas junto
# com o módulo de autenticação, com validação de startup e ADR correspondente.
# Mantidas aqui apenas como referência do que precisará ser provisionado.
# -----------------------------------------------------------------------------

# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# ACCESS_TOKEN_TTL=
# REFRESH_TOKEN_TTL=
# REFRESH_COOKIE_DOMAIN=
# REFRESH_COOKIE_SAMESITE=
